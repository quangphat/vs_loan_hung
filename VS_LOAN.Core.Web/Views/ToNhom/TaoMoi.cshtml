@using VS_LOAN.Core.Web.Resources;
@{
    ViewBag.Title = "Tạo tổ nhóm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model String
<script type="text/javascript">
    SetActiveMenu('@ViewBag.formindex', 2);
</script>
<div class="main-content-inner">
    <div class="breadcrumbs" id="breadcrumbs">
        <ul class="breadcrumb">
            <li>
                <i class="fa fa-caret-right"></i>
                <a href="#">Tạo tổ nhóm</a>
            </li>
        </ul>
    </div>
    <div class="page-content" id="panel_body">
        <div class="row">
            <div class="col-xs-12 app-card">
                <h3 class="app-section-heading">1. Thông tin tổ nhóm</h3>
                <form class="form-horizontal" role="form">
                    <div class="form-group">
                        <label for="form-field-1" class="col-sm-2 control-label no-padding-right">Tên <span class="required">(*)</span> </label>
                        <div class="col-sm-4">
                            <input type="text" id="txtTenNhom" placeholder="Nhập tên nhóm" class="form-control">
                        </div>
                        <label for="form-field-1" class="col-sm-2 control-label no-padding-right">Tên khác <span class="required">(*)</span> </label>
                        <div class="col-sm-4">
                            <input type="text" id="txtTenNgan" placeholder="Nhập tên ngắn" class="form-control">
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-2 control-label no-padding-right">Người quản lý<span class="required">(*)</span></label>
                        <div class="col-sm-4">
                            <select id="ddlNguoiQL" class="chosen-select form-control" data-placeholder="Chọn người quản lý">
                                <option value="0"></option>
                            </select>
                        </div>
                        <label class="col-sm-2 control-label no-padding-right">Nhóm cha</label>
                        <div class="col-sm-4">
                            <select id="ddlNhomCha" class="chosen-select form-control" data-placeholder="Chọn nhóm cha">
                                <option value="0"></option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12 app-card">
                <h3 class="app-section-heading">2. Thành viên nhóm</h3>
                <div class="group-member-picker">
                    <p class="group-member-hint">Tìm nhân viên ở danh sách bên trái, chọn rồi thêm vào nhóm. Có thể chọn nhiều nhân viên cùng lúc.</p>
                    <div class="form-group">
                        <div class="col-sm-12">
                            <select multiple="multiple" size="10" name="duallistbox_demo1[]" id="duallistNhanVien"></select>
                        </div>
                    </div>
                    <div class="group-member-pagination">
                        <span>Danh sách nhân viên được chia theo trang</span>
                        <div class="btn-group" role="group" aria-label="Điều hướng danh sách nhân viên">
                            <button type="button" class="btn btn-default btn-sm" id="btnPrevious"><i class="fa fa-chevron-left"></i> Trang trước</button>
                            <button type="button" class="btn btn-default btn-sm" id="btnNext">Trang sau <i class="fa fa-chevron-right"></i></button>
                            <button type="button" class="btn btn-primary btn-sm" id="btnSearch"><i class="fa fa-search"></i> Tìm nhân viên</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-xs-12">
                <hr />
                <div class="pull-right">
                    <a class="btn btn-sm btn-primary" id="btn_Save">
                        Lưu
                    </a>
                   
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Content/ace-master/assets/js/jquery.bootstrap-duallistbox.min.js"></script>
<script>
    let page = 1;
    var selectedMembers = [];

    function rememberSelectedMembers() {
        var rightList = $('select[name="duallistbox_demo1[]_helper2"]')[0];
        if (!rightList) return;
        selectedMembers = [];
        for (var i = 0; i < rightList.options.length; i++) {
            selectedMembers.push({ id: rightList.options[i].value, name: rightList.options[i].text });
        }
    }

    $(document).ready(function () {
        GetMembers(page);
        GetAllEmployees();
        LayDSNhom();
        //filter id = "#duallist_filter_id"
        demo1 = $('select[name="duallistbox_demo1[]"]').bootstrapDualListbox({
            nonSelectedListLabel: 'Nhân viên có thể thêm',
            selectedListLabel: 'Thành viên nhóm',
            filterPlaceHolder: 'Lọc trong danh sách...',
            filterTextClear: 'Xóa lọc',
            infoText: 'Hiển thị {0} nhân viên',
            infoTextFiltered: 'Tìm thấy {0} trên {1} nhân viên',
            infoTextEmpty: 'Không có nhân viên',
            moveSelectedLabel: 'Thêm đã chọn',
            moveAllLabel: 'Thêm tất cả',
            removeSelectedLabel: 'Gỡ đã chọn',
            removeAllLabel: 'Gỡ tất cả',
            moveOnSelect: false
        });
        var filterBox = document.getElementById('duallist_filter_id');
        if (filterBox != null) {
            filterBox.addEventListener("keyup", function (event) {
                
                if (event.key === "Enter") {
                    GetMembers(1);
                }
            });
        }
       
    });

    //jQuery(function ($) {
    //    var demo1 = $('select[name="duallistbox_demo1[]"]').bootstrapDualListbox({ infoTextFiltered: '<span class="label label-purple label-lg">Filtered</span>', filterPlaceHolder: '', filterTextClear: '', infoText: '', infoTextFiltered: '' });
        
    //    var container1 = demo1.bootstrapDualListbox('getContainer');
    //    container1.find('.btn').addClass('btn-white btn-info btn-bold');

    //    ///////////////////
    //    //example taken from plugin's page at: https://twitter.github.io/typeahead.js/examples/
    //    var substringMatcher = function (strs) {
    //        return function findMatches(q, cb) {
    //            var matches, substringRegex;

    //            // an array that will be populated with substring matches
    //            matches = [];

    //            // regex used to determine if a string contains the substring `q`
    //            substrRegex = new RegExp(q, 'i');

    //            // iterate through the pool of strings and for any string that
    //            // contains the substring `q`, add it to the `matches` array
    //            $.each(strs, function (i, str) {
    //                if (substrRegex.test(str)) {
    //                    debugger
    //                    // the typeahead jQuery plugin expects suggestions to a
    //                    // JavaScript object, refer to typeahead docs for more info
    //                    matches.push({ value: str });
    //                }
    //            });

    //            cb(matches);
    //        }
    //    }

    //    //in ajax mode, remove remaining elements before leaving page
    //    $(document).one('ajaxloadstart.page', function (e) {
    //        $('select[name="duallistbox_demo1[]"]').bootstrapDualListbox('destroy');
    //    });

    //});
    $("#btnNext").click(function () {
        page += 1;
        GetMembers(page)
    })
    $("#btnPrevious").click(function () {
        page -= 1;
        page = page <= 0 ? 1 : page
        GetMembers(page)
    })
    $("#btnSearch").click(function () {
        page = 1;
        GetMembers(page)
    })
    function GetAllEmployees(page) {
        showBlock($('#panel_body'), 'Vui lòng chờ');
        $('#ddlNguoiQL').empty();

        
        $.ajax({
            type: "GET",
            url: `/Employee/GetAllEmployee`,
            data: {},
            success: function (data) {
                if (data.data != null && data.success == true) {
                    if (data.data != null && data.data.length > 0) {
                        $.each(data.data, function (index, item) {

                           
                            $('#ddlNguoiQL').append($('<option>', { value: item.Id, text: item.Name }));

                        });
                        if (data.data.length == 1) {
                            $('#ddlNguoiQL').val(data.data[0].Id);
                        }
                    }
                }
               
                $('#ddlNguoiQL').chosen().trigger("chosen:updated");
                $('#ddlNguoiQL').trigger("change");
            },
            complete: function () {
                $('#panel_body').unblock();
                page = page
            },
            error: function (jqXHR, exception) {
                showError(jqXHR, exception);
            }
        });
    }
    function GetMembers(page) {
        showBlock($('#panel_body'), 'Vui lòng chờ');
        rememberSelectedMembers();
        $('#duallistNhanVien').empty();

        let freeText = isNullOrUndefined($("#duallist_filter_id").val()) ? '' : $("#duallist_filter_id").val();
        $.ajax({
            type: "GET",
            url: '@Url.Action("GetAllEmployeePaging", "Employee")',
            data: { page: page, freeText: freeText },
            success: function (data) {
                if (data.data != null && data.success == true) {
                    if (data.data != null && data.data.length > 0) {
                        $.each(data.data, function (index, item) {
                            $('#duallistNhanVien').append($('<option>', { value: item.Id, text: item.Name }));
                        });
                    }
                }
                $.each(selectedMembers, function (index, item) {
                    var option = $('#duallistNhanVien option[value="' + item.id + '"]');
                    if (option.length === 0) {
                        $('#duallistNhanVien').append($('<option>', { value: item.id, text: item.name, selected: true }));
                    }
                    else option.prop('selected', true);
                });
                $('#duallistNhanVien').bootstrapDualListbox('refresh', true);
                $('#ddlNguoiQL').chosen().trigger("chosen:updated");
                $('#ddlNguoiQL').trigger("change");
            },
            complete: function () {
                $('#panel_body').unblock();
                page = page
            },
            error: function (jqXHR, exception) {
                showError(jqXHR, exception);
            }
        });
    }


    function LayDSNhom() {
        $('#ddlNhomCha').empty();
        $('#ddlNhomCha').append("<option value='0'></option>");
        $.ajax({
            type: "POST",
            url: '@Url.Action("LayDSNhomCha", "ToNhom")',
            data: {},
            success: function (data) {
                if (data.data != null && data.success == true) {
                    if (data.data != null && data.data.length > 0) {
                        $.each(data.data, function (index, item) {
                            $('#ddlNhomCha').append($('<option>', { value: item.ID, text: item.Ten }));
                        });
                        if (data.data.length == 1) {
                            $('#ddlNhomCha').val(data.data[0].ID);
                        }
                    }
                }
                $('#ddlNhomCha').chosen().trigger("chosen:updated");
                $('#ddlNhomCha').trigger("change");
            },
            complete: function () {
            },
            error: function (jqXHR, exception) {
                showError(jqXHR, exception);
            }
        });
    }
</script>
<script>
    $('#btn_Save').click(function (e) {
        if ($('#txtTenNhom').val() == '') {
            swal({
                title: "",
                text: "Vui lòng nhập tên nhóm!",
                type: "error",
                timer: 4000,
                showConfirmButton: true,
            });
            return;
        }
        if ($('#txtTenNgan').val() == '') {
            swal({
                title: "",
                text: "Vui lòng nhập tên ngắn!",
                type: "error",
                timer: 4000,
                showConfirmButton: true,
            });
            return;
        }
        var lstRightSelect = $('select[name="duallistbox_demo1[]_helper2"]')[0];
        var lstSelectedId = [];
        for (var i = 0; i < lstRightSelect.length; i++) {
            lstSelectedId.push(lstRightSelect[i].attributes[0].value);
        }
        if (lstSelectedId.length == 0)
        {
            swal({
                title: "",
                text: "Vui lòng chọn thành viên nhóm!",
                type: "error",
                timer: 4000,
                showConfirmButton: true,
            });
            return;
        }
        var objectSend = JSON.stringify({
            'ten': $('#txtTenNhom').val(),
            'tenNgan': $('#txtTenNgan').val(),
            'maNguoiQuanLy': $('#ddlNguoiQL').val(),
            'maNhomCha': $('#ddlNhomCha').val(),
            'lstThanhVien': lstSelectedId
        });
        $.ajax({
            traditional: true,
            url: '@Url.Action("ThemMoi", "ToNhom")',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            data: objectSend,
            success: function (data) {
                if (data.success == true) {
                    swal({
                        title: "@Html.Raw(Global.Message_Title)",
                        text: "Thành công",
                        type: "success",
                        timer: 4000,
                        showConfirmButton: true,
                    }, function () {
                        window.location = window.location;
                    });
                }
                else {
                    swal({
                        title: "@Html.Raw(Global.Message_Title)",
                        text: data.code,
                        type: "error",
                        timer: 4000,
                        showConfirmButton: true,
                    });
                }
            },
            error: function (jqXHR, exception) {
                showError(jqXHR, exception);
            },
            complete: function () {
                $('#panel_body').unblock();
            },
        });
    });
</script>